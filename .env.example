# Copy to .env for local runs (docker-compose / uvicorn --env-file .env).
# Railway: set these under Project > Variables instead.

# SQLite path inside the container. Leave as-is unless you attach a Railway
# volume at a different mount path. Only used when DATABASE_URL is unset —
# ignored entirely once POSTGRES_*/DATABASE_URL below are in play.
DATA_DIR=/app/data

# PostgreSQL + Docker Compose deployment (Customer Request 2 Epic N — see
# docker-compose.yml and README.md's "Deploy dengan Docker Compose +
# PostgreSQL" section). docker-compose.yml builds DATABASE_URL from these
# three at container start (host "db" = the Postgres service's name on the
# Compose network, not "localhost").
#
# Generate a real password ONCE per VPS with:
#   openssl rand -base64 24
# or, if openssl isn't available:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Never use a literal example password like "postgres"/"password123".
POSTGRES_USER=umkm_app
POSTGRES_PASSWORD=ganti_dengan_password_hasil_generate
POSTGRES_DB=umkm_omni

# Session cookie signing key — generate the same way as POSTGRES_PASSWORD
# above. Without this set, the app falls back to a demo-only key, which is
# fine for local testing but must never be used for a real deployment.
SESSION_SECRET_KEY=ganti_dengan_secret_key_hasil_generate

# SMTP for the forgot-password email flow (Customer Request 1 Epic M).
# These example values point at a Mailtrap SANDBOX inbox — mail sent through
# it is captured in the Mailtrap web UI, it is NOT delivered to the real
# recipient's inbox. This is intentional for testing, not a bug: if a real
# user reports "I didn't get the reset email", check Mailtrap's inbox, don't
# assume delivery is broken. Swap these for a production SMTP provider
# (host/port/username/password/from-address) when going live — no code
# changes needed, app/services/email_service.py reads everything from here.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=4398c66ac1e2ab
SMTP_PASSWORD=d17be71cd6c381
SMTP_FROM_ADDRESS=noreply@umkmapp.com
