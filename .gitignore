# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# SQLite database file
*.db
*.sqlite3
/app/data/

# Environment variables
.env
.env.*
# ...except the committed template itself (Customer Request 2 Epic N relies
# on this being trackable so anyone cloning the repo sees which variables
# they need to fill in — the .env.* pattern above would otherwise silently
# swallow it too).
!.env.example

# Logs
*.log

# IDE/editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store

# Node modules (if any frontend tooling appears later)
node_modules/
